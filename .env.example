# Copy this file to .env and fill in real values:
#   cp .env.example .env
# Never commit the real .env file.

# --- Database (PostgreSQL) ---
# Used by docker-compose to create the database container.
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# Connection string used by Payload. Local development only: put it in
# .env.development.local. In production docker-compose builds it from the
# DB_* values above (host "db"), so the server's .env doesn't need it.
DATABASE_URI=postgres://your_db_user:your_db_password@localhost:5432/your_db_name

# --- Payload CMS ---
# Long random string, e.g. generated with: openssl rand -base64 32
PAYLOAD_SECRET=your_payload_secret_here

# --- NextAuth ---
# Public URL of the site, e.g. https://example.com (http://localhost:3000 locally)
NEXTAUTH_URL=http://localhost:3000
# Long random string, e.g. generated with: openssl rand -base64 32
NEXTAUTH_SECRET=your_nextauth_secret_here

# --- Google OAuth (https://console.cloud.google.com/apis/credentials) ---
# Authorized redirect URI: <NEXTAUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# --- Access control ---
# Comma-separated list of emails that get admin rights
ADMIN_EMAILS=admin@example.com,another-admin@example.com

# --- E2E tests (Playwright) ---
# Tests use a separate database so they never touch dev data. Put these in
# .env.test.local (same names as above, different values):
#   DATABASE_URI=postgres://your_db_user:your_db_password@localhost:5432/ilya_e2e
#   PAYLOAD_SECRET=<same as dev>
#   NEXTAUTH_SECRET=<same as dev>
#   NEXTAUTH_URL=http://localhost:3001
# The seed script refuses to run unless the database name contains "_e2e".
# Create the database once with:
#   docker compose exec db sh -c 'createdb -U "$POSTGRES_USER" ilya_e2e'
# Then run: npm run test:e2e
