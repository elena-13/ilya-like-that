# Copy this file to .env and fill in real values:
#   cp .env.example .env
# Never commit the real .env file.

# --- Database (PostgreSQL) ---
# Used by docker-compose to create the database container.
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# Connection string used by Payload.
# In docker-compose it is built from the DB_* values above (host "db").
# For local development outside Docker, point it at your own Postgres instance.
DATABASE_URI=postgres://your_db_user:your_db_password@localhost:5432/your_db_name

# --- Payload CMS ---
# Long random string, e.g. generated with: openssl rand -base64 32
PAYLOAD_SECRET=your_payload_secret_here

# --- NextAuth ---
# Public URL of the site, e.g. https://example.com (http://localhost:3000 locally)
NEXTAUTH_URL=http://localhost:3000
# Long random string, e.g. generated with: openssl rand -base64 32
NEXTAUTH_SECRET=your_nextauth_secret_here

# --- Google OAuth (https://console.cloud.google.com/apis/credentials) ---
# Authorized redirect URI: <NEXTAUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# --- Access control ---
# Comma-separated list of emails that get admin rights
ADMIN_EMAILS=admin@example.com,another-admin@example.com
